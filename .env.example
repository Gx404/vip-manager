# 用自己的 HTTPS 域名替换，不含尾部斜杠；本地开发使用 http://127.0.0.1:5173
PUBLIC_ORIGIN=https://members.example.com
# true：免登录展示真实会员（名称、套餐、金额、日期等）；备注仅登录后可见。公开服务器请慎重开启。
PUBLIC_DASHBOARD=false
# 只在空数据库首次启动时创建管理员；至少 16 字符，不要复用其他网站密码
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# HTTPS 正式部署必须为 true；仅本地 HTTP 测试改为 false
COOKIE_SECURE=true
APP_TIMEZONE=Asia/Shanghai
# Compose 开启 TRUST_PROXY；独立 Node 反代部署需手动设为 true，并按实际网络缩小可信代理范围。
TRUSTED_PROXY_RANGES=loopback,linklocal,uniquelocal
# 默认只接受宿主机反向代理，不直接把看板暴露在公网
BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080
